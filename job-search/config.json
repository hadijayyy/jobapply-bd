  "cron": "CRON_TZ=Asia/Jakarta 7 7 * * 1-5",
  "note": "Sekali sehari Senin-Jumat pagi WIB"
 },
 "freshness_days": 45,
 "followup_days": [
  5,
  10
 ],
 "tier_threshold": {
  "A": 65,
  "B": 45
 },
 "report_max_items": 10,
