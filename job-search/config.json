 "location_good": "indonesia|jakarta|apac|asia|southeast asia|asean|singapore|malaysia|kuala lumpur|worldwide|anywhere|everywhere",
 "hard_blockers": [
  {
   "id": "license",
   "label": "Butuh lisensi WPE/WAPERD/OJK",
   "pattern": "waperd|\\bwpe\\b|wakil perantara|licensed (securities|insurance)|OJK licen"
  },
  {
   "id": "mandarin",
   "label": "Mandarin wajib",
   "pattern": "(mandarin|chinese)[^.\\n]{0,40}(fluen|required|must|mandatory|native)|(fluen|proficien)[^.\\n]{0,30}(mandarin|chinese)"
  },
  {
   "id": "crypto",
   "label": "Pengalaman crypto/Web3 wajib",
   "pattern": "(experience|background|track record)[^.\\n]{0,40}(crypto|web3|blockchain|defi)(?![^.\\n]{0,40}(preferred|plus|nice|bonus|advantage))"
  },
  {
   "id": "years7",
   "label": "Syarat 7+ tahun",
   "pattern": "\\b(?:7|8|9|10|12|15)\\s*\\+?\\s*(?:-\\s*\\d+\\s*)?(?:years|yrs)[^.\\n]{0,40}(experience|sales|business development|enterprise)"
  },
  {
   "id": "commission",
   "label": "Komisi saja",
   "pattern": "commission[- ]only|100% commission|no base salary|unpaid"
  },
  {
   "id": "onsite_abroad",
   "label": "Onsite/hybrid di luar Jakarta",
   "pattern": "(on-?site|hybrid|in[- ]office)[^.\\n]{0,30}(singapore|kuala lumpur|malaysia|bangkok|manila|sydney|hong kong|tokyo|seoul|dubai)",
   "waived_by_sponsorship": true
  },
  {
   "id": "residency",
   "label": "Wajib residen negara lain",
   "pattern": "(must|need to|required to)[^.\\n]{0,30}(reside|be located|be based|live)[^.\\n]{0,30}(singapore|malaysia|australia|thailand|philippines|vietnam|hong kong)|(singapore|malaysia|australia)[^.\\n]{0,15}(citizen|pr|permanent resident)[^.\\n]{0,15}(only|required)",
   "waived_by_sponsorship": true
  },
  {
   "id": "lang_other",
   "label": "Wajib bahasa lain (Jepang/Korea/Thai/Viet/Mandarin)",
   "pattern": "(fluent|fluency|native|proficien\\w*)[^.\\n]{0,15}(in )?(japanese|korean|thai|vietnamese|mandarin|cantonese|tagalog)\\b(?![^.\\n]{0,30}(plus|preferred|nice|advantage|beneficial))|(japanese|korean|thai|vietnamese|mandarin|cantonese)[^.\\n]{0,40}(crucial|required|essential|mandatory|a must)"
  },
  {
   "id": "domain_req",
   "label": "Wajib pengalaman industri spesifik (SaaS-essential / adtech / iGaming)",
   "pattern": "selling saas[^.\\n]{0,30}(essential|required|must)|(years?|yrs)[^.\\n]{0,60}(programmatic|mobile advertising|igaming)|(programmatic|igaming)[^.\\n]{0,40}(required|essential|must)"
  }
 ],
 "red_flags": [
  {
   "id": "pay_to_apply",
   "label": "Minta bayar/deposit",
   "pattern": "registration fee|training fee|deposit|pay (a|the) fee|biaya (pendaftaran|pelatihan)"
  },
  {
   "id": "wallet",
   "label": "Minta connect wallet/seed phrase",
   "pattern": "seed phrase|connect (your )?wallet|private key"
  },
  {
   "id": "mlm",
   "label": "MLM/investasi/trading",
   "pattern": "\\bmlm\\b|multi-?level|downline|binary option|forex trading signal"
  },
  {
   "id": "dm_only",
   "label": "Rekrut lewat DM/Gmail pribadi saja",
   "pattern": "(dm|message) (me|us) (to apply|on (telegram|whatsapp))|apply via (telegram|whatsapp)"
  }
 ],
 "soft_flags": [
  {
   "id": "us_hours",
   "label": "Jam kerja US/EU",
   "pattern": "\\b(us|est|pst|cst|eastern|pacific|uk|cet) (hours|time ?zone)|overlap with (us|eu)"
  },
  {
   "id": "years6",
   "label": "Syarat 6 tahun (Ryan 5+)",
   "pattern": "\\b6\\s*\\+?\\s*(?:years|yrs)[^.\\n]{0,40}(experience|sales|business development|enterprise)"
  },
  {
   "id": "travel",
   "label": "Perlu willingness to travel (tidak ada di profil)",
   "pattern": "willing(ness)? to travel|travel (up to|extensively|\\d+%)"
  },
  {
   "id": "malay",
   "label": "Minta Bahasa Malay (Ryan: Indonesia native, tulis jujur)",
   "pattern": "bahasa (malay|melayu)|\\bmalay\\b"
  }
 ],
